rules_version = '2';
// Paste into Firebase console -> Firestore -> Rules (v2: per-space data).
// Every space lists its people in spaces/{sid}.members (lowercase emails). Admins are docs in admins/{email}, created by hand, never in git.
// The daily job uses the Admin SDK, which ignores these rules. The times Worker reads and writes as the signed-in user, so these rules apply to it too.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function isAdmin() { return signed() && exists(/databases/$(database)/documents/admins/$(mail())); }
    function member(sid) { return signed() && mail() in get(/databases/$(database)/documents/spaces/$(sid)).data.members; }

    // A user reads only their own admin doc, so the app can tell whether to show Admin.
    match /admins/{email} {
      allow get: if signed() && mail() == email;
    }

    // Invite links: an admin makes and removes them; anyone signed in may look one up by its code (not list them).
    match /invites/{code} {
      allow get: if signed();
      allow list, create, delete: if isAdmin();
    }

    // Listing needs the caller in members (the app queries members array-contains). Admins also list, create and remove spaces.
    // The owner may change members and name only, and cannot drop themself.
    match /spaces/{sid} {
      allow get, list: if signed() && (mail() in resource.data.members || isAdmin());
      // Admins create spaces for anyone. Anyone else may create exactly one, their own: its id is their uid, they are its
      // only member, and it names a live invite link.
      allow create: if (isAdmin() && request.resource.data.owner in request.resource.data.members)
        || (signed() && sid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'invite'])
          && request.resource.data.owner == mail() && request.resource.data.members == [mail()]
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.invite is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite)));
      allow update: if signed() && mail() == resource.data.owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'name'])
        && resource.data.owner in request.resource.data.members;
      // Only once its keys are gone, so an admin can't delete and re-create a space as themself to read someone's keys.
      allow delete: if isAdmin() && !exists(/databases/$(database)/documents/spaces/$(sid)/private/keys);

      // Keys and calendar links: members only. An admin may delete them (when removing a space) but can't read them.
      // Admins are still trusted: they can see every space's name and members.
      match /private/{id} {
        allow read, write: if member(sid);
        allow delete: if isAdmin();
      }

      // An admin may write only the first settings doc, in the same batch that creates the space (get() sees the pre-write state, so they are not a member yet).
      match /settings/{id} {
        allow read, write: if member(sid);
        // The admin writes a new space's first settings in the same batch that creates the space.
        allow create: if isAdmin() && id == 'main'
          && !exists(/databases/$(database)/documents/spaces/$(sid))
          && existsAfter(/databases/$(database)/documents/spaces/$(sid));
        // ...and so does someone creating their own space from an invite link.
        allow create: if signed() && id == 'main' && sid == request.auth.uid
          && !exists(/databases/$(database)/documents/spaces/$(sid))
          && getAfter(/databases/$(database)/documents/spaces/$(sid)).data.owner == mail();
      }

      match /suggestions/{id} { allow read: if member(sid); }
      match /latest/{id} { allow read: if member(sid); }
      match /routes/{id} { allow read: if member(sid); }

      // The app may only change `override`; everything else on a label belongs to the job.
      match /labels/{id} {
        allow read: if member(sid);
        allow update: if member(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['override'])
          && (request.resource.data.override == null || request.resource.data.override is bool);
      }

      // The job owns meta. The one exception: the times lookup (done as the user) bumps budget.used by exactly 2.
      match /meta/{id} {
        allow read: if member(sid);
        allow update: if id == 'budget' && member(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
          && request.resource.data.used == resource.data.used + 2;
      }

      // A phone writes its own push token. Update is allowed too, so tapping "Turn on alerts" twice (or a token refresh) doesn't fail.
      match /devices/{token} {
        allow create, update: if member(sid) && request.resource.data.email == mail();
        allow delete: if member(sid) && resource.data.email == mail();
      }
    }

    // The shared weather cache is for the job only.
    match /climate/{id} {
      allow read, write: if false;
    }
  }
}
