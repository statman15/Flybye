rules_version = '2';
// Paste into Firebase console -> Firestore -> Rules. The two allowed Google accounts live in allow/{email}: lowercase email as the doc ID, created by hand, never in git.
// The daily job uses the Admin SDK, which ignores these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function ok() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allow/$(request.auth.token.email.lower()));
    }

    match /settings/{id} {
      allow read, write: if ok();
    }

    match /suggestions/{id} {
      allow read: if ok();
    }

    // The app may only change `override`; everything else on a label belongs to the job.
    match /labels/{id} {
      allow read: if ok();
      allow update: if ok()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['override'])
        && (request.resource.data.override == null || request.resource.data.override is bool);
    }

    // A phone writes its own push token. Update is allowed too, so tapping "Turn on alerts" twice (or a token refresh) doesn't fail.
    match /devices/{token} {
      allow create, update: if ok() && request.resource.data.email == request.auth.token.email;
      allow delete: if ok();
    }

    // Read only your own doc, so the app can tell "signed in but not allowed".
    match /allow/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
    }
  }
}
