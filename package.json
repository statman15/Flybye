{
  "name": "flybye",
  "private": true,
  "type": "module",
  "description": "npm is only for the Capacitor Android shell and the smoke test; the web app itself has no build step.",
  "scripts": {
    "smoke": "node --check web/sw.js && node smoke.mjs web",
    "www": "node copy-web.js",
    "sync": "node copy-web.js && cap sync android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "puppeteer-core": "25.13.0"
  }
}
